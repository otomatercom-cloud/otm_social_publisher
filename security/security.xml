<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_social_publisher" model="res.groups.privilege">
        <field name="name">Social Publisher</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_social_publisher"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_social_publisher"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_social_publisher"/>
        <field name="implied_ids" eval="[(4, ref('group_approver'))]"/>
    </record>
</odoo>
