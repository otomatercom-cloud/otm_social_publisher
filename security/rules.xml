<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_post_company" model="ir.rule">
        <field name="name">Social post: multi-company</field>
        <field name="model_id" ref="model_otm_social_post"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_post_own" model="ir.rule">
        <field name="name">Social post: users see their own posts</field>
        <field name="model_id" ref="model_otm_social_post"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>

    <record id="rule_post_all" model="ir.rule">
        <field name="name">Social post: approvers see all posts</field>
        <field name="model_id" ref="model_otm_social_post"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approver'))]"/>
    </record>

    <record id="rule_account_company" model="ir.rule">
        <field name="name">Social account: multi-company</field>
        <field name="model_id" ref="model_otm_social_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_target_parent" model="ir.rule">
        <field name="name">Social post result: follows the post</field>
        <field name="model_id" ref="model_otm_social_post_target"/>
        <field name="domain_force">[('post_id', 'any', [])]</field>
    </record>
</odoo>
