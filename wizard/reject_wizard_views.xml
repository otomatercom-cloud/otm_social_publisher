<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_post_reject_wizard" model="ir.ui.view">
        <field name="name">otm.social.post.reject.wizard.form</field>
        <field name="model">otm.social.post.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Post">
                <group>
                    <field name="post_id" invisible="1"/>
                    <field name="reason" placeholder="Tell the requester what to fix..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
